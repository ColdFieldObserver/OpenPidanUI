<Window x:Class="HomeSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home 组件设置" Height="540" Width="780"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: avatar preview + actions -->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Border Width="180" Height="180" CornerRadius="90"
                    BorderBrush="#CCCCCC" BorderThickness="1" HorizontalAlignment="Center">
                <Image x:Name="AvatarPreview" Width="180" Height="180"
                       Stretch="UniformToFill" ClipToBounds="True"/>
            </Border>
            <Button x:Name="PickLocalButton" Content="从本地选择图片"
                    Margin="0,14,0,6" Height="34" Click="PickLocalButton_Click"/>
            <Button x:Name="OpenFolderButton" Content="打开皮肤文件夹"
                    Height="34" Click="OpenFolderButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                       FontSize="11" Foreground="#666666"/>
        </StackPanel>

        <!-- Right: nickname + presets + save -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="昵称" FontWeight="Bold"/>
            <TextBox x:Name="NicknameBox" Grid.Row="1" Height="32"
                     VerticalContentAlignment="Center" Margin="0,4,0,0"/>

            <TextBlock Grid.Row="2" Text="预设头像" FontWeight="Bold" Margin="0,14,0,4"/>

            <ListBox x:Name="PresetList" Grid.Row="3"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PresetList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="60" Height="60" CornerRadius="30" Margin="4"
                                BorderBrush="#CCCCCC" BorderThickness="1">
                            <Image Source="{Binding ImagePath}" Width="60" Height="60"
                                   Stretch="UniformToFill"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="SaveButton" Content="保存" Width="110" Height="38"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
